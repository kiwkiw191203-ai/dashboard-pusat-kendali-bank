{
  "name": "ShiftIssue",
  "type": "object",
  "properties": {
    "issue_date": {
      "type": "string",
      "description": "Tanggal kendala (YYYY-MM-DD)"
    },
    "shift": {
      "type": "string",
      "description": "Shift saat kendala terjadi (pagi / malam)"
    },
    "title": {
      "type": "string",
      "description": "Judul / ringkasan kendala"
    },
    "detail": {
      "type": "string",
      "description": "Detail kendala & serah terima"
    },
    "handover_to": {
      "type": "string",
      "description": "Diserahkan kepada (nama / shift berikutnya)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done"
      ],
      "default": "open",
      "description": "Status kendala"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu kendala diselesaikan"
    },
    "resolved_by": {
      "type": "string",
      "description": "Nama yang menyelesaikan kendala"
    },
    "creator_name": {
      "type": "string",
      "description": "Nama pelapor (otomatis)"
    },
    "creator_email": {
      "type": "string",
      "description": "Email pelapor (otomatis)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": true,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_master"
          }
        },
        {
          "user_condition": {
            "role": "kapten"
          }
        }
      ]
    }
  }
}