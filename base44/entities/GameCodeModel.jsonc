{
  "name": "GameCodeModel",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Kode/ID unik hasil spin game (gabungan angka dari screenshot)"
    },
    "model_name": {
      "type": "string",
      "description": "Nama model/game slot"
    },
    "provider": {
      "type": "string",
      "enum": [
        "pg",
        "pp",
        "other"
      ],
      "default": "pg",
      "description": "Provider game"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    }
  },
  "required": [
    "code",
    "model_name"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_master"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_master"
          }
        }
      ]
    }
  }
}