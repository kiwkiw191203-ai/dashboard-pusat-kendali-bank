{
  "name": "RoleTemplate",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_master",
        "kapten",
        "kasir",
        "cs",
        "master",
        "member"
      ],
      "description": "Role yang memiliki template ini"
    },
    "feature": {
      "type": "string",
      "description": "Feature key"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "role",
    "feature"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "super_master"
      }
    },
    "update": {
      "user_condition": {
        "role": "super_master"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_master"
      }
    }
  }
}